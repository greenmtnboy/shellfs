# name: test/sql/arrow_pipe.test
# description: Test pipe reading with multiple buffers (regression test for Windows zero-byte read bug)
# group: [shellfs]

# Require statement will ensure this test is run with this extension loaded
require shellfs

# This test validates that pipes handle data correctly when it arrives in multiple buffers.
# On Windows, the previous implementation would close pipes prematurely on zero-byte reads
# from _popen(), which would occur when buffers weren't ready yet. This would truncate
# Arrow IPC streams and other binary data formats.

# Test 1: Large CSV data stream through pipe that requires multiple reads
query II
SELECT COUNT(*), SUM(column0) FROM read_csv('seq 1 10000 | awk ''{print $1 "," $1*2}'' |')
----
10000	50005000

# Test 2: Pipe with slower data generation (using sleep to simulate buffering delays)
# This helps test the fix because it increases chances of zero-byte reads
query I
SELECT COUNT(*) FROM read_csv('seq 1 100 | awk ''BEGIN {OFS=","} {print $1, $1*2; if (NR % 25 == 0) system("sleep 0.01")}'' |')
----
100

# Test 3: Very large dataset to ensure multiple buffer reads work correctly
query I
SELECT COUNT(DISTINCT column0) FROM read_csv('seq 1 50000 | awk ''{print $1 "," $1}'' |')
----
50000
